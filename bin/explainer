#!/usr/bin/env bash
# Run the explainer as its own claude process, against the work session's transcript.
#
# This is the only invocation that keeps the work conversation clean. /explain
# spawns a subagent inside that conversation, so the answer has to travel back
# through the main agent and lands in its context permanently. Here nothing is
# shared but a file on disk that the work session is already writing.
#
#   explainer                          open a session to ask in, in this directory
#   explainer "what does ledger mean?" ask once, print the answer, exit
#   explainer --sessions               which conversations were found here
#   explainer --transcript PATH        explain a specific transcript
#   explainer --resume [N]             bring back an earlier chat of this repository
#
# Quote a one-shot question. zsh reads ? and * as filename patterns (the
# install script prints a noglob alias for that), an apostrophe needs double
# quotes, and ! needs single ones; long questions are easier in the chat.
#
# Run it from the same directory the work session was opened in; that is how it
# finds the conversation to read.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tail_py="$here/transcript-tail.py"
layout_py="$here/explainer_layout.py"

transcript=""
resume_mode=""
resume_id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --sessions) exec "$tail_py" --list-sessions ;;
    --transcript) transcript="${2:?--transcript needs a path}"; shift 2 ;;
    # Lists this repository's earlier chats and asks which one, unless a number or
    # a session-id prefix follows. The answer comes back as "resume <id>", or as
    # "fork <id>" when that chat is still open in another window.
    --resume)
      shift
      selector=""
      if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then selector="$1"; shift; fi
      plan="$(python3 "$layout_py" pick-chat ${selector:+"$selector"})" || exit $?
      resume_mode="${plan%% *}"
      resume_id="${plan#* }"
      ;;
    -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; exit 0 ;;
    --) shift; break ;;
    # An unknown option used to fall through as the question, so a mistyped or
    # not-yet-existing flag silently cost a model call. A question that really
    # starts with "-" goes after "--".
    -*) echo "explainer: unknown option: $1" >&2
        echo "Run 'explainer --help' for usage; put a question starting with '-' after '--'." >&2
        exit 2 ;;
    *) break ;;
  esac
done

# Resolved before claude starts: at this instant the newest transcript here is
# still the work session, because the session about to be launched has not
# written its own yet.
if [ -z "$transcript" ]; then
  transcript="$("$tail_py" --resolve-target)"
fi

session="$(uuidgen | tr '[:upper:]' '[:lower:]')"

# Read-only at the tool layer, not merely by instruction. The agent definition
# says the same thing, but a prompt is a request and this is a refusal.
tools=(
  "Read" "Grep" "Glob" "WebSearch" "WebFetch"
  "Bash(cat:*)" "Bash(head:*)" "Bash(tail:*)" "Bash(sed:*)" "Bash(wc:*)"
  "Bash(ls:*)" "Bash(find:*)" "Bash(grep:*)" "Bash(rg:*)" "Bash(file:*)"
  "Bash(git log:*)" "Bash(git show:*)" "Bash(git diff:*)" "Bash(git blame:*)"
  "Bash(git rev-parse:*)" "Bash(git worktree list:*)" "Bash(git status:*)"
  # Both spellings: the agent is told to type "~/.claude/bin/...", and a pattern
  # holding the expanded home path never matches an unexpanded tilde.
  "Bash(~/.claude/bin/transcript-tail.py:*)"
  "Bash(~/.claude/bin/explainer-glossary.py:*)"
  "Bash($HOME/.claude/bin/transcript-tail.py:*)"
  "Bash($HOME/.claude/bin/explainer-glossary.py:*)"
  "Bash($tail_py:*)" "Bash($here/explainer-glossary.py:*)"
)

# Only user-level settings. The permissions this agent may use are given
# outright below, so a project's settings.local.json adds nothing except its
# warnings about its own wildcard rules, printed over the answer.
settings=(--setting-sources user)
# EXPLAINER_SETTINGS (inline JSON or a file path) is layered over them with
# --settings. The eval suite uses it to switch off the machine owner's own
# language, output style and CLAUDE.md, so a result means the same everywhere.
if [ -n "${EXPLAINER_SETTINGS:-}" ]; then
  settings+=(--settings "$EXPLAINER_SETTINGS")
fi

# Every other worktree of this repository. The main agent can move into one in
# the middle of a session, and its claims are then about the files there; read
# access outside the working directory was measured to work for Read and grep
# but not for cat. Worktrees added after launch still get Read and grep.
here_real="$(pwd -P)"
while IFS= read -r line; do
  case "$line" in
    "worktree "*)
      wt="${line#worktree }"
      [ "$wt" != "$here_real" ] && [ -d "$wt" ] && settings+=(--add-dir "$wt")
      ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null || true)

export EXPLAINER_TRANSCRIPT="$transcript"

# What the explainer knows before its first tool call: the project, its recent
# history and where the work session stands, built here in code and appended to
# the system prompt. Left in TMPDIR because claude reads it after this script is
# gone; macOS clears it.
briefing="$(mktemp "${TMPDIR:-/tmp}/explainer-briefing.XXXXXX")"
"$tail_py" --briefing >"$briefing" 2>/dev/null || :
settings+=(--append-system-prompt-file "$briefing")

if [ -n "$resume_mode" ]; then
  if [ $# -gt 0 ]; then
    echo "explainer: --resume opens the chat; ask your question there" >&2
    exit 2
  fi
  export EXPLAINER_MODE=chat
  # A resumed or forked conversation reuses the system prompt recorded when it
  # began, unless told to rebuild it (measured), and this launch can differ from
  # that one.
  if [ "$resume_mode" = fork ]; then
    exec claude --agent explainer --resume "$resume_id" --fork-session \
      --session-id "$session" --system-prompt-snapshot off \
      "${settings[@]}" --allowedTools "${tools[@]}"
  fi
  exec claude --agent explainer --resume "$resume_id" --system-prompt-snapshot off \
    "${settings[@]}" --allowedTools "${tools[@]}"
fi

if [ $# -gt 0 ]; then
  export EXPLAINER_MODE=once
  # </dev/null: -p reads stdin for piped input and otherwise spends three
  # seconds waiting for it before warning and carrying on.
  exec claude -p --agent explainer --session-id "$session" \
    "${settings[@]}" --allowedTools "${tools[@]}" -- "$*" </dev/null
fi

export EXPLAINER_MODE=chat
exec claude --agent explainer --session-id "$session" \
  "${settings[@]}" --allowedTools "${tools[@]}"
